{
  "version": 2,
  "builds": [
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/js/(.*)", "headers": { "Cache-Control": "public, max-age=300, s-maxage=300" }, "continue": true },
    { "src": "/css/(.*)", "headers": { "Cache-Control": "public, max-age=3600, s-maxage=3600" }, "continue": true },
    { "src": "/assets/(.*)", "headers": { "Cache-Control": "public, max-age=86400, s-maxage=86400" }, "continue": true },
    { "src": "/(.*)", "headers": { "Cache-Control": "public, max-age=0, s-maxage=0" }, "continue": true }
  ]
}
