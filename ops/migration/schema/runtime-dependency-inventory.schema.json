{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ge16.example/ops/migration/schema/runtime-dependency-inventory.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["format", "schema", "active_code_rules", "files"],
  "properties": {
    "format": {"const": "ge16-runtime-dependency-inventory/v1"},
    "schema": {"const": "runtime-dependency-inventory.schema.json"},
    "active_code_rules": {"$ref": "#/$defs/rules"},
    "files": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/file"}},
    "code_files": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/code_file"}},
    "embedded_sources": {"type": "array"}, "automation_references": {"type": "object"}, "latest_reports": {"type": "object"}, "scan_scope": {"type": "object"}
  },
  "$defs": {
    "rules": {"type": "object", "additionalProperties": false, "required": ["suffixes", "excluded_components", "excluded_suffixes"], "properties": {"suffixes": {"type": "array", "items": {"type": "string"}}, "excluded_components": {"type": "array", "items": {"type": "string"}}, "excluded_suffixes": {"type": "array", "items": {"type": "string"}}}},
    "code_file": {"type": "object", "additionalProperties": false, "required": ["path", "lstat_bytes", "file_type", "sha256", "symlink_target", "git", "active_code_status", "classification_reason", "inbound_callers", "reads", "writes", "dependency_status"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"}, "lstat_bytes": {"type": "integer", "minimum": 0}, "file_type": {"enum": ["regular", "symlink", "other"]}, "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "symlink_target": {"type": ["string", "null"]}, "git": {"$ref": "#/$defs/git"}, "active_code_status": {"enum": ["candidate", "excluded", "not-code"]}, "classification_reason": {"type": "string", "minLength": 1}, "inbound_callers": {"$ref": "#/$defs/strings"}, "reads": {"$ref": "#/$defs/strings"}, "writes": {"$ref": "#/$defs/strings"}, "dependency_status": {"const": "unresolved"}}, "allOf": [{"if": {"properties": {"file_type": {"const": "regular"}}}, "then": {"properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "symlink_target": {"type": "null"}}}}, {"if": {"properties": {"file_type": {"const": "symlink"}}}, "then": {"properties": {"sha256": {"type": "null"}, "symlink_target": {"type": "string"}}}}, {"if": {"properties": {"file_type": {"const": "other"}}}, "then": {"properties": {"sha256": {"type": "null"}, "symlink_target": {"type": "null"}}}}]},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "lstat_bytes", "file_type", "sha256", "symlink_target", "git", "active_code_status", "classification_reason", "inbound_callers", "reads", "writes", "dependency_status", "classification", "disposition_status", "disposition_reason", "destination", "counterpart"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"}, "lstat_bytes": {"type": "integer", "minimum": 0}, "file_type": {"const": "regular"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "symlink_target": {"type": "null"}, "git": {"$ref": "#/$defs/git"}, "active_code_status": {"const": "candidate"}, "classification_reason": {"type": "string", "minLength": 1}, "inbound_callers": {"$ref": "#/$defs/strings"}, "reads": {"$ref": "#/$defs/strings"}, "writes": {"$ref": "#/$defs/strings"}, "dependency_status": {"const": "unresolved"}, "classification": {"const": "runtime"}, "disposition_status": {"const": "unresolved"}, "disposition_reason": {"type": "string", "minLength": 1}, "destination": {"type": "null"}, "counterpart": {"type": "null"}}},
    "git": {"type": "object", "additionalProperties": false, "required": ["tracked", "ignored", "state"], "properties": {"tracked": {"type": ["boolean", "null"]}, "ignored": {"type": ["boolean", "null"]}, "state": {"enum": ["tracked", "ignored", "untracked", "unresolved"]}}, "oneOf": [{"properties": {"tracked": {"const": true}, "ignored": {"const": false}, "state": {"const": "tracked"}}}, {"properties": {"tracked": {"const": false}, "ignored": {"const": true}, "state": {"const": "ignored"}}}, {"properties": {"tracked": {"const": false}, "ignored": {"const": false}, "state": {"const": "untracked"}}}, {"properties": {"tracked": {"type": "null"}, "ignored": {"type": "null"}, "state": {"const": "unresolved"}}}]},
    "strings": {"type": "array", "items": {"type": "string"}}
  }
}
